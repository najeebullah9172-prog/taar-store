# Copy to .env and fill in. Never commit the real .env file.
NODE_ENV=production
PORT=3000
BASE_URL=https://www.your-domain.pk
# At least 32 random characters, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Set to 1 when running behind Nginx, Caddy, Cloudflare or a load balancer
TRUST_PROXY=1
DB_PATH=./data/taar.db
UPLOAD_DIR=./uploads
# Password for admin@taar.pk when you run "npm run seed" for the first time
ADMIN_PASSWORD=

# Email. Leave empty to only log emails in Admin > Messages.
# Example: smtps://user:password@smtp.zoho.com:465
SMTP_URL=
MAIL_FROM=Taar <orders@your-domain.pk>

# Payments. The built in test gateway must be turned off for a live store.
PAYMENT_SANDBOX=0
SAFEPAY_ENV=production
SAFEPAY_API_KEY=
SAFEPAY_SECRET=
SAFEPAY_WEBHOOK_SECRET=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
