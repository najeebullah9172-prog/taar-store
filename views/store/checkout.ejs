<%
  locals.bare = true;
  locals.scripts = ['checkout'];
  const v = values;
  const fieldErr = (k) => errors[k] ? `<div class="err" id="err-${k}"><svg class="i i-sm"><use href="#i-alert"/></svg>${errors[k].replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])}</div>` : '';
  const inv = (k) => errors[k] ? `aria-invalid="true" aria-describedby="err-${k}"` : '';
%>
<%- include('../partials/top', locals) %>
<header class="checkout-head">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Taar home">
      <svg viewBox="0 0 44 24" aria-hidden="true"><path d="M2 12h24" stroke="#2346c8" stroke-width="3" stroke-linecap="round" fill="none"/><circle cx="33" cy="12" r="7" stroke="#2346c8" stroke-width="3" fill="none"/></svg>
      <span class="logo-word">taar</span>
    </a>
    <div class="steps" aria-label="Checkout progress">
      <span class="step done"><span class="node"></span>Cart</span><span class="step-line done"></span>
      <span class="step cur"><span class="node"></span>Details and payment</span><span class="step-line"></span>
      <span class="step"><span class="node"></span>Confirmation</span>
    </div>
    <a class="btn btn-ghost btn-sm" href="/cart"><svg class="i i-sm"><use href="#i-left"/></svg>Back to cart</a>
  </div>
</header>

<div class="wrap">
  <form class="checkout" method="post" action="/checkout" novalidate data-checkout>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <% if (errors._) { %><div class="alert alert-error" role="alert" style="margin-bottom:16px"><svg class="i"><use href="#i-alert"/></svg><div><%= errors._ %></div></div><% } %>
      <% if (Object.keys(errors).length && !errors._) { %><div class="alert alert-error" role="alert" style="margin-bottom:16px" tabindex="-1" data-error-summary><svg class="i"><use href="#i-alert"/></svg><div>Please fix the highlighted fields below.</div></div><% } %>

      <section class="co-section" aria-labelledby="co-contact">
        <h2 id="co-contact"><span class="node node-fill"></span>Contact</h2>
        <% if (!user) { %><p class="small muted" style="margin-top:-8px">Have an account? <a class="link" href="/account/login?next=/checkout">Sign in</a> for faster checkout. Otherwise continue as a guest.</p><% } %>
        <div class="grid-2">
          <label class="field <%= errors.email ? 'has-error' : '' %>"><span class="label">Email</span>
            <input class="input" name="email" type="email" autocomplete="email" required value="<%= v.email %>" <%- inv('email') %>><%- fieldErr('email') %>
            <span class="hint">We send your receipt and tracking here.</span></label>
          <label class="field <%= errors.phone ? 'has-error' : '' %>"><span class="label">Mobile number</span>
            <input class="input" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="0300 1234567" required value="<%= formatPhone(v.phone) || v.phone %>" <%- inv('phone') %>><%- fieldErr('phone') %>
            <span class="hint">The rider calls this number before delivery.</span></label>
        </div>
      </section>

      <section class="co-section" aria-labelledby="co-addr">
        <h2 id="co-addr"><span class="node node-fill"></span>Delivery address</h2>
        <% if (addresses.length) { %>
          <div class="addr-picker" role="group" aria-label="Saved addresses">
            <% for (const a of addresses) { %>
              <button type="button" class="addr-card" data-address='<%= JSON.stringify({ full_name: a.full_name, phone: formatPhone(a.phone), line1: a.line1, line2: a.line2 || "", city: a.city, province: a.province, postal_code: a.postal_code || "" }) %>' aria-pressed="<%= a.line1 === v.line1 && a.city === v.city %>">
                <strong><%= a.label || a.full_name %></strong><%= a.line1 %><%= a.line2 ? ', ' + a.line2 : '' %><br><%= a.city %>
              </button>
            <% } %>
          </div>
        <% } %>
        <label class="field <%= errors.full_name ? 'has-error' : '' %>"><span class="label">Full name</span>
          <input class="input" name="full_name" autocomplete="name" required value="<%= v.full_name %>" <%- inv('full_name') %>><%- fieldErr('full_name') %></label>
        <label class="field <%= errors.line1 ? 'has-error' : '' %>"><span class="label">Address</span>
          <input class="input" name="line1" autocomplete="address-line1" placeholder="House number, street, block" required value="<%= v.line1 %>" <%- inv('line1') %>><%- fieldErr('line1') %></label>
        <label class="field"><span class="label">Area or landmark <span class="opt">(optional)</span></span>
          <input class="input" name="line2" autocomplete="address-line2" placeholder="For example DHA Phase 5, near Jalal Sons" value="<%= v.line2 || '' %>"></label>
        <div class="grid-2" style="margin-top:16px">
          <label class="field <%= errors.city ? 'has-error' : '' %>"><span class="label">City</span>
            <select class="select" name="city" required data-city <%- inv('city') %>>
              <option value="">Choose your city</option>
              <% for (const c of cities) { %><option value="<%= c %>" data-province="<%= cityProvince[c] %>" <%= v.city === c ? 'selected' : '' %>><%= c %></option><% } %>
            </select><%- fieldErr('city') %>
            <span class="hint">Not listed? Choose the nearest city and add your town in the address.</span></label>
          <label class="field <%= errors.province ? 'has-error' : '' %>"><span class="label">Province</span>
            <select class="select" name="province" required data-province-select <%- inv('province') %>>
              <option value="">Choose province</option>
              <% for (const p of provinces) { %><option <%= v.province === p ? 'selected' : '' %>><%= p %></option><% } %>
            </select><%- fieldErr('province') %></label>
        </div>
        <label class="field <%= errors.postal_code ? 'has-error' : '' %>" style="max-width:220px;margin-top:16px"><span class="label">Postal code <span class="opt">(optional)</span></span>
          <input class="input" name="postal_code" inputmode="numeric" maxlength="5" autocomplete="postal-code" value="<%= v.postal_code || '' %>" <%- inv('postal_code') %>><%- fieldErr('postal_code') %></label>
        <% if (user) { %><label class="check" style="margin-top:16px"><input type="checkbox" name="save_address" <%= v.save_address ? 'checked' : '' %>>Save this address to my account</label><% } %>
      </section>

      <section class="co-section" aria-labelledby="co-ship">
        <h2 id="co-ship"><span class="node node-fill"></span>Delivery method</h2>
        <div class="choice" data-ship-options>
          <% if (!summary.shippingOptions.length) { %>
            <p class="muted small" style="margin:0">Choose your city above to see delivery options.</p>
          <% } %>
          <% for (const m of summary.shippingOptions) { %>
            <label class="choice-opt"><input type="radio" name="shipping_method" value="<%= m.id %>" <%= (summary.shippingMethod && summary.shippingMethod.id === m.id) ? 'checked' : '' %>>
              <div><div class="t"><%= m.label %></div><div class="d"><%= m.eta %></div></div><span class="r num"><%= m.fee ? money(m.fee) : 'Free' %></span></label>
          <% } %>
        </div>
        <%- fieldErr('shipping_method') %>
      </section>

      <section class="co-section" aria-labelledby="co-pay">
        <h2 id="co-pay"><span class="node node-fill"></span>Payment</h2>
        <div class="choice" data-pay-options>
          <% for (const m of payMethods) { %>
            <label class="choice-opt <%= m.disabled ? 'is-disabled' : '' %>" data-pay="<%= m.id %>">
              <input type="radio" name="payment_method" value="<%= m.id %>" <%= v.payment_method === m.id && !m.disabled ? 'checked' : '' %> <%= m.disabled ? 'disabled' : '' %>>
              <div><div class="t"><%= m.label %><% if (m.test) { %> <span class="pill pill-amber" style="height:22px">Test mode</span><% } %></div><div class="d" data-pay-note><%= m.disabled || m.note %></div></div>
              <svg class="i"><use href="#i-<%= m.id === 'cod' ? 'cash' : m.id === 'card' ? 'card' : 'bank' %>"/></svg>
            </label>
          <% } %>
        </div>
        <%- fieldErr('payment_method') %>
        <label class="field" style="margin-top:18px"><span class="label">Order note <span class="opt">(optional)</span></span>
          <textarea class="textarea" name="note" maxlength="500" rows="2" style="min-height:70px" placeholder="Delivery instructions, gift message or anything else"><%= v.note || '' %></textarea></label>
      </section>

      <% if (!user) { %>
      <section class="co-section" aria-labelledby="co-acct">
        <h2 id="co-acct"><span class="node"></span>Save your details <span class="opt muted" style="font-weight:400;font-size:15px">(optional)</span></h2>
        <label class="check"><input type="checkbox" name="create_account" data-create-account <%= v.create_account ? 'checked' : '' %>>Create an account to track orders and check out faster next time</label>
        <label class="field <%= v.create_account ? '' : 'hide' %> <%= errors.account_password ? 'has-error' : '' %>" data-account-password style="margin-top:14px;max-width:360px"><span class="label">Choose a password</span>
          <input class="input" type="password" name="account_password" autocomplete="new-password" minlength="8" <%- inv('account_password') %>>
          <span class="hint">At least 8 characters with a letter and a number.</span><%- fieldErr('account_password') %></label>
      </section>
      <% } %>
    </div>

    <aside class="card summary-card" aria-label="Order summary">
      <h2 style="font-size:20px;margin-bottom:18px">Order summary</h2>
      <div class="mini-lines">
        <% for (const l of summary.lines) { %>
          <div class="mini-line"><div class="img"><img src="<%= l.image %>" alt=""><span class="q"><%= l.qty %></span></div>
            <div><div style="font-weight:600;line-height:1.3"><%= l.name %></div><% if (l.variant_label) { %><div class="xs muted"><%= l.variant_label %></div><% } %>
              <% if (l.problem) { %><div class="xs" style="color:var(--red);font-weight:600"><%= l.problem %></div><% } %></div>
            <div class="num" style="font-weight:600"><%= money(l.line_total) %></div></div>
        <% } %>
      </div>
      <% if (summary.coupon && summary.coupon.ok) { %><div class="coupon-tag" style="margin-top:16px"><span><%= summary.coupon.code %> applied</span><a class="xs" href="/cart">Change</a></div><% } %>
      <div class="totals" style="margin-top:18px" data-totals>
        <div><span>Subtotal</span><span class="num" data-t="subtotal"><%= money(summary.subtotal) %></span></div>
        <div class="disc" <%= summary.discount ? '' : 'hidden' %> data-row="discount"><span>Discount</span><span class="num" data-t="discount">&minus;<%= money(summary.discount) %></span></div>
        <div><span>Delivery</span><span class="num" data-t="shipping"><%= summary.shippingMethod ? (summary.shipping ? money(summary.shipping) : 'Free') : 'Choose city' %></span></div>
        <div <%= summary.paymentFee ? '' : 'hidden' %> data-row="fee"><span>Cash handling fee</span><span class="num" data-t="fee"><%= money(summary.paymentFee) %></span></div>
        <div class="grand"><span>Total</span><span class="num" data-t="total"><%= money(summary.total) %></span></div>
      </div>
      <label class="check small <%= errors.accept_terms ? 'has-error' : '' %>" style="margin-top:18px"><input type="checkbox" name="accept_terms" required <%= v.accept_terms ? 'checked' : '' %>><span>I agree to the <a class="link" href="/pages/terms" target="_blank">terms of sale</a> and <a class="link" href="/pages/returns" target="_blank">return policy</a>.</span></label>
      <%- fieldErr('accept_terms') %>
      <button class="btn btn-primary btn-block btn-lg" type="submit" style="margin-top:16px" data-place-order <%= summary.hasProblems ? 'disabled' : '' %>>Place order</button>
      <div class="secure-note"><svg class="i i-sm"><use href="#i-lock"/></svg>Your details are sent over an encrypted connection.</div>
    </aside>
  </form>
</div>
<%- include('../partials/bottom', locals) %>
