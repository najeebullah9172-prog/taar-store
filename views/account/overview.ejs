<%- include('../partials/top', locals) %>
<div class="wrap">
  <header class="page-head"><h1>Hello, <%= user.name.split(' ')[0] %></h1></header>
  <div class="account">
    <%- include('../partials/acct-nav') %>
    <div class="stack">
      <div class="grid-2">
        <a class="card" href="/account/orders"><div class="small muted">Orders</div><div style="font-size:28px;font-weight:700" class="num"><%= counts.n %></div><div class="small muted"><%= counts.open %> in progress</div></a>
        <a class="card" href="/wishlist"><div class="small muted">Saved products</div><div style="font-size:28px;font-weight:700" class="num"><%= wish %></div><div class="small muted">In your wishlist</div></a>
      </div>
      <section class="card">
        <div class="row-between" style="margin-bottom:8px"><h2 style="font-size:19px">Recent orders</h2><a class="link small" href="/account/orders">All orders</a></div>
        <% if (!recent.length) { %><p class="muted">No orders yet. When you place one, you can track it here.</p><a class="btn btn-ink" href="/shop">Start shopping</a><% } %>
        <% for (const o of recent) { %>
          <a class="order-row" href="/account/orders/<%= o.number %>" style="grid-template-columns:1fr auto auto">
            <div><div style="font-weight:600" class="num"><%= o.number %></div><div class="small muted"><%= dateFmt(o.created_at) %></div></div>
            <%- include('../partials/status-pill', { s: o.status }) %>
            <div class="num" style="font-weight:700"><%= money(o.total) %></div>
          </a>
        <% } %>
      </section>
      <section class="card">
        <div class="row-between" style="margin-bottom:8px"><h2 style="font-size:19px">Default address</h2><a class="link small" href="/account/addresses">Manage</a></div>
        <% if (address) { %><p style="margin:0"><%= address.full_name %>, <%= address.line1 %>, <%= address.city %></p><% } else { %><p class="muted" style="margin:0">No saved address yet.</p><% } %>
      </section>
    </div>
  </div>
</div>
<%- include('../partials/bottom', locals) %>
