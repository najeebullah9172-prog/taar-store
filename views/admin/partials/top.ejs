<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Taar admin</title>
  <meta name="robots" content="noindex, nofollow"><meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/store.css?v=<%= assetV %>"><link rel="stylesheet" href="/css/admin.css?v=<%= assetV %>">
</head>
<body class="admin">
<%- include('../../partials/icons') %>
<div class="adm">
  <aside class="adm-side" data-adm-side>
    <a class="logo" href="/admin"><svg viewBox="0 0 44 24" aria-hidden="true" style="height:24px"><path d="M2 12h24" stroke-width="3" stroke-linecap="round" fill="none"/><circle cx="33" cy="12" r="7" stroke-width="3" fill="none"/></svg><span class="logo-word" style="font-size:22px">taar</span><small>admin</small></a>
    <nav class="adm-nav" aria-label="Admin">
      <% for (const n of adminNav) { const cur = n.href === '/admin' ? (path === '/admin' || path === '/admin/') : (path === n.href || path.startsWith(n.href + '/')); %>
        <a href="<%= n.href %>" <%= cur ? 'aria-current=page' : '' %>><svg class="i"><use href="#i-<%= n.icon %>"/></svg><%= n.label %><% if (n.badge) { %><span class="badge"><%= n.badge %></span><% } %></a>
      <% } %>
    </nav>
    <div class="adm-side-foot">
      <a href="/" target="_blank"><svg class="i i-sm"><use href="#i-store"/></svg>View store</a>
      <span><%= user.name %>, <%= user.role %></span>
      <form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><svg class="i i-sm"><use href="#i-logout"/></svg>Sign out</button></form>
    </div>
  </aside>
  <div class="adm-main">
    <header class="adm-top">
      <div class="row">
        <button class="icon-btn adm-menu" type="button" data-adm-menu aria-label="Menu"><svg class="i"><use href="#i-menu"/></svg></button>
        <div><h1><%= title %></h1><% if (locals.sub) { %><div class="sub"><%= sub %></div><% } %></div>
      </div>
      <div class="row"><%- locals.actions || '' %></div>
    </header>
    <div class="adm-body">
      <% if (flash) { %><div class="alert alert-<%= flash.type === 'error' ? 'error' : 'success' %>" role="status" style="margin-bottom:16px"><svg class="i"><use href="#i-<%= flash.type === 'error' ? 'alert' : 'check' %>"/></svg><div><%= flash.message %></div></div><% } %>
