<% locals.title = 'Categories'; const e = edit || {}; const icons = ['phone', 'laptop', 'monitor', 'headphones', 'watch', 'gamepad', 'camera', 'tv', 'plug']; %>
<%- include('partials/top', locals) %>
<div class="cols cols-main">
  <section class="panel">
    <div class="t-wrap"><table class="t">
      <thead><tr><th>Order</th><th>Name</th><th>Filters shoppers see</th><th class="r">Products</th><th></th></tr></thead>
      <tbody><% for (const c of list) { %>
        <tr><td><%= c.sort %></td><td><strong><%= c.name %></strong> <% if (!c.active) { %><span class="pill">Hidden</span><% } %><div class="xs muted">/c/<%= c.slug %></div></td><td class="small"><%= c.spec_filters.join(', ') %></td><td class="r"><%= c.n %></td>
          <td class="r"><div class="row" style="justify-content:flex-end"><a class="btn btn-ghost btn-sm" href="/admin/categories?edit=<%= c.id %>">Edit</a>
            <form method="post" action="/admin/categories/<%= c.id %>/delete" data-confirm="Delete <%= c.name %>?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit">Delete</button></form></div></td></tr>
      <% } %></tbody>
    </table></div>
  </section>
  <form class="panel stack" method="post" action="/admin/categories">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (e.id) { %><input type="hidden" name="id" value="<%= e.id %>"><% } %>
    <h2 style="font-size:16.5px"><%= e.id ? 'Edit ' + e.name : 'Add a category' %></h2>
    <label class="field"><span class="label">Name</span><input class="input" name="name" required value="<%= e.name || '' %>"></label>
    <label class="field"><span class="label">URL handle</span><input class="input" name="slug" value="<%= e.slug || '' %>" placeholder="Made from the name"></label>
    <label class="field"><span class="label">Tagline</span><input class="input" name="tagline" value="<%= e.tagline || '' %>"></label>
    <label class="field"><span class="label">Description</span><textarea class="textarea" name="description" rows="3" style="min-height:80px"><%= e.description || '' %></textarea></label>
    <label class="field"><span class="label">Filter names</span><input class="input" name="spec_filters" value="<%= (e.spec_filters || []).join(', ') %>" placeholder="RAM, Storage"><span class="hint">Specification names shoppers can filter by, separated by commas.</span></label>
    <div class="grid-2"><label class="field"><span class="label">Icon</span><select class="select" name="icon"><% for (const i of icons) { %><option <%= e.icon === i ? 'selected' : '' %>><%= i %></option><% } %></select></label>
      <label class="field"><span class="label">Position</span><input class="input" type="number" name="sort" value="<%= e.sort ?? list.length %>"></label></div>
    <label class="check"><input type="checkbox" name="active" <%= e.id ? (e.active ? 'checked' : '') : 'checked' %>>Show in the store</label>
    <div class="row"><button class="btn btn-primary btn-sm" type="submit">Save category</button><% if (e.id) { %><a class="btn btn-ghost btn-sm" href="/admin/categories">Cancel</a><% } %></div>
  </form>
</div>
<%- include('partials/bottom', locals) %>
